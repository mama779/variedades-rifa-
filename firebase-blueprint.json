{
  "entities": {
    "raffle": {
      "title": "Raffle",
      "description": "Raffle event object",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "prizeValue": { "type": "string", "maxLength": 100 },
        "prizeImage": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 100 },
        "totalNumbers": { "type": "integer" },
        "digits": { "type": "integer" },
        "drawDate": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "drawing", "completed", "paused"] },
        "maxTicketsPerUser": { "type": "integer" },
        "winningNumber": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "description", "category", "totalNumbers", "status", "createdAt"]
    },
    "ticket": {
      "title": "Ticket",
      "description": "Individual ticket for a raffle",
      "type": "object",
      "properties": {
        "number": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["available", "pending_verification", "assigned"] },
        "userId": { "type": "string", "maxLength": 100 },
        "userName": { "type": "string", "maxLength": 200 },
        "userPhone": { "type": "string", "maxLength": 50 },
        "userHandle": { "type": "string", "maxLength": 100 },
        "assignedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["number", "status"]
    },
    "socialLink": {
      "title": "SocialLink",
      "description": "Social community or channel link",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "platform": { "type": "string", "maxLength": 50 },
        "url": { "type": "string", "maxLength": 500 },
        "label": { "type": "string", "maxLength": 200 },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "platform", "url", "isActive"]
    },
    "verificationRequest": {
      "title": "VerificationRequest",
      "description": "Participation verification request submitted by user",
      "type": "object",
      "properties": {
        "raffleId": { "type": "string", "maxLength": 100 },
        "raffleTitle": { "type": "string", "maxLength": 200 },
        "userId": { "type": "string", "maxLength": 100 },
        "userName": { "type": "string", "maxLength": 200 },
        "userPhone": { "type": "string", "maxLength": 50 },
        "userHandle": { "type": "string", "maxLength": 100 },
        "requestedTicketNumber": { "type": "string", "maxLength": 20 },
        "submittedAt": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string", "maxLength": 500 }
      },
      "required": ["raffleId", "userId", "userName", "status", "submittedAt"]
    },
    "winnerHistoryItem": {
      "title": "WinnerHistoryItem",
      "description": "Public item recorded when a winner is drawn",
      "type": "object",
      "properties": {
        "raffleTitle": { "type": "string", "maxLength": 200 },
        "prizeValue": { "type": "string", "maxLength": 100 },
        "prizeImage": { "type": "string", "maxLength": 500 },
        "winnerName": { "type": "string", "maxLength": 200 },
        "winnerPhoneMasked": { "type": "string", "maxLength": 50 },
        "ticketNumber": { "type": "string", "maxLength": 20 },
        "drawDate": { "type": "string", "maxLength": 100 },
        "proofUrl": { "type": "string", "maxLength": 500 },
        "testimonial": { "type": "string", "maxLength": 500 }
      },
      "required": ["raffleTitle", "winnerName", "ticketNumber", "drawDate"]
    },
    "notification": {
      "title": "Notification",
      "description": "User alert or system notification",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 50 },
        "read": { "type": "boolean" },
        "raffleId": { "type": "string", "maxLength": 100 },
        "ticketNumber": { "type": "string", "maxLength": 20 }
      },
      "required": ["title", "message", "timestamp", "type", "read"]
    }
  },
  "firestore": {
    "/raffles/{raffleId}": {
      "schema": "raffle",
      "description": "Collection of all raffles"
    },
    "/raffles/{raffleId}/tickets/{ticketNumber}": {
      "schema": "ticket",
      "description": "Subcollection of tickets per raffle"
    },
    "/social_links/{linkId}": {
      "schema": "socialLink",
      "description": "Collection of social media links"
    },
    "/verification_requests/{requestId}": {
      "schema": "verificationRequest",
      "description": "Collection of admin verification requests"
    },
    "/winners_history/{winnerId}": {
      "schema": "winnerHistoryItem",
      "description": "Collection of past raffle winners"
    },
    "/notifications/{notifId}": {
      "schema": "notification",
      "description": "Collection of notifications"
    }
  }
}
